# ==============================================================================
# Fantasy NBA — Docker 生产环境变量
# 使用方法：复制为 .env.docker，填写实际值，不要提交到 Git
# ==============================================================================

# ── MySQL ─────────────────────────────────────────────────────────────────────
# MySQL root 密码（容器初始化用）
DB_ROOT_PASSWORD=change_me_root_password

# 应用连接用的数据库账号（会自动创建）
DB_USERNAME=fantasy_nba
DB_PASSWORD=change_me_db_password
DB_DATABASE=fantasy_nba_prod
# 首次部署建表：设置 DB_SYNCHRONIZE=true，启动成功后务必移除或设为空
# DB_SYNCHRONIZE=true

# ── JWT ───────────────────────────────────────────────────────────────────────
# 至少 32 位随机字符串，生成命令：openssl rand -hex 32
JWT_SECRET=change_me_replace_with_a_very_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── 前端 API 路径（构建时注入）────────────────────────────────────────────────
# 通过宿主机 Nginx 同域转发，使用相对路径 /api
# 宿主机 Nginx 会自动将 /api/* 剥离前缀后转发给 API 容器
# 通常不需要修改此项
VITE_API_URL=/api

# ── 管理员账号 ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# ── 新浪数据同步（可选）──────────────────────────────────────────────────────
SINA_BASE_URL=https://slamdunk.sports.sina.com.cn/api
NBA_SEASON=2025
# 比赛期间爬取间隔（分钟）
POLL_INTERVAL_MINUTES=5
