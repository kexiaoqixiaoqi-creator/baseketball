# =============================================================================
# 生产环境专用配置
# 复制为 .env.production，部署时使用
# NODE_ENV=production 时自动加载，synchronize 会关闭
# =============================================================================

NODE_ENV=production
DB_DATABASE=fantasy_nba_prod

# 生产环境必须使用强密码和独立 JWT Secret（在 .env 或部署平台配置）
# DB_PASSWORD=***
# JWT_SECRET=***
