    "@nestjs/mapped-types": "^2.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.0",
